{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexusDeck",
  "version": "0.6.2",
  "identifier": "com.andrei.nexus-deck",
"build": {
    "beforeDevCommand": "npm run watch:ui",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NexusDeck",
     "width": 1440,
  "height": 860,
  "minWidth": 1380,
  "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

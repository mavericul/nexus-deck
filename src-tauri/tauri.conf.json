{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexusDeck",
  "version": "0.7.1",
  "identifier": "com.andrei.nexus-deck",
"build": {
    "beforeDevCommand": "npm run watch:ui",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NexusDeck",
        "width": 1440,
        "height": 860,
        "minWidth": 1380,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFNTg2M0E5Q0YxNDY2OUMKUldTY1poVFBxV05ZVGl6dExhdk92YUt5QS9iMzRZUExBazNTN0t6MEdRKytuYWQ4UStuM2ZIbDIK",
      "endpoints": [
        "https://github.com/mavericul/nexus-deck/releases/latest/download/latest.json"
      ]
    }
  }
}
